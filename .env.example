# Copie este arquivo para .env e preencha.
# NUNCA versione o .env (ele contém segredos).

# ---------- Geral ----------
NODE_ENV=development
PORTA=3000
NOME_SISTEMA=Consulta Rating
# URL pública HTTPS do sistema (necessária para o webhook do Mercado Pago em produção)
PUBLIC_URL=

# Preço cobrado por consulta (R$)
PRECO_CONSULTA=19.90
# Limites de recarga (R$)
RECARGA_MIN=20
RECARGA_MAX=2000
# Dias que o relatório completo fica disponível no histórico (LGPD: minimize)
RETENCAO_DIAS=90

# ---------- API KSI ----------
# simulado = devolve a resposta de exemplo da documentação | real = chama a API KSI
KSI_MODO=simulado
KSI_BASE_URL=https://apiksiconsultas.com.br
KSI_LOGIN=
KSI_SENHA=
# Prefixo do header Authorization (a documentação usa o token puro; confirme com o suporte KSI)
KSI_AUTH_PREFIX=
# Timeout da consulta em ms
KSI_TIMEOUT_MS=120000
# Renovar o token preventivamente após N minutos (validade oficial: consulte o suporte KSI)
KSI_TOKEN_TTL_MIN=30

# ---------- Pagamento (recarga PIX) ----------
# simulado = botão "simular pagamento" (bloqueado em produção) | mercadopago = PIX real
PAGAMENTO_MODO=simulado
MP_ACCESS_TOKEN=
# Assinatura secreta do webhook (painel Mercado Pago > Webhooks)
MP_WEBHOOK_SECRET=
PIX_EXPIRA_MIN=30
